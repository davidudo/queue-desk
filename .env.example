# Application
NODE_ENV=development
LOG_LEVEL=info

# API Server
API_PORT=4000
API_HOST=0.0.0.0
API_REQUEST_TIMEOUT_MS=15000
API_BODY_LIMIT=1mb
CORS_ORIGIN=http://localhost:5173

# Authentication & Security
JWT_SECRET=replace-with-a-minimum-32-character-random-secret-key
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# PostgreSQL
DATABASE_URL=postgresql://davidudo@localhost:5432/queuedesk
TEST_DATABASE_URL=postgresql://davidudo@localhost:5432/queuedesk_test
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000

# Synthetic Data Seeding
# Profiles: test (500), small (5000), medium (50000), large (250000)
SEED_PROFILE=small
SEED_RANDOM=42

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_ENABLE_DEV_QUICK_LOGIN=true
