{
  "name": "queuedesk",
  "version": "1.0.0",
  "private": true,
  "description": "QueueDesk — Production-grade internal support ticket management platform",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @queuedesk/api dev\" \"pnpm --filter @queuedesk/web dev\"",
    "dev:api": "pnpm --filter @queuedesk/api dev",
    "dev:web": "pnpm --filter @queuedesk/web dev",
    "build": "pnpm --filter @queuedesk/shared build && pnpm --filter @queuedesk/api build && pnpm --filter @queuedesk/web build",
    "typecheck": "pnpm --filter @queuedesk/shared typecheck && pnpm --filter @queuedesk/api typecheck && pnpm --filter @queuedesk/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm --filter @queuedesk/shared test && pnpm --filter @queuedesk/api test:unit && pnpm --filter @queuedesk/web test",
    "test:integration": "pnpm --filter @queuedesk/api test:integration",
    "test:e2e": "playwright test",
    "test:coverage": "pnpm --filter @queuedesk/shared test:coverage && pnpm --filter @queuedesk/api test:coverage && pnpm --filter @queuedesk/web test:coverage",
    "db:migrate": "tsx database/scripts/migrate.ts",
    "db:seed": "tsx database/seeds/seed.ts",
    "db:reset": "tsx database/scripts/reset.ts",
    "benchmark": "tsx benchmarks/run-autocannon.ts",
    "benchmark:explain": "tsx benchmarks/run-explain.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "autocannon": "^8.0.0",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,sql}": [
      "prettier --write"
    ]
  }
}
